# Copy this file to terraform.tfvars and set your subscription ID and a strong password.
# terraform.tfvars is excluded by .gitignore — never commit secrets or credentials.

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus2"
prefix          = "gsalab"
admin_username  = "labadmin"
admin_password  = "REPLACE-WITH-STRONG-LAB-PASSWORD!"

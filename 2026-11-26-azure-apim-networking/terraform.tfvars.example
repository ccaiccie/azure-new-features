# Copy this file to terraform.tfvars and set globally unique values.
# WARNING: Azure API Management bills continuously until destroyed, and
# provisioning in internal VNet mode typically takes 30 to 40 minutes.

resource_group_name = "rg-apim-networking-lab"
location            = "eastus2"
apim_name           = "apim-ntlab-replace-me"
publisher_name      = "Network Technician Lab"
publisher_email     = "mike@example.com"
apim_sku_name       = "Developer_1"
appgw_waf_mode      = "Detection"
